#!/usr/bin/env bash
set -euo pipefail

SLOPMUX_COMMAND=slopmux-rm
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/slopmux-common"

usage() {
    local status=${1:-2} fd=2
    (( status == 0 )) && fd=1
    echo "usage: slopmux-rm [-b|--delete-branch] NAME..." >&"$fd"
    exit "$status"
}
delete_branch=false
names=()
while (( $# )); do
    case $1 in
        -b|--delete-branch) delete_branch=true ;;
        -h|--help) usage 0 ;;
        --) shift; names+=("$@"); break ;;
        -*) usage ;;
        *) names+=("$1") ;;
    esac
    shift
done
(( ${#names[@]} )) || usage

slopmux_locate_parent
slopmux_prepare_registry
current_directory=$(pwd -P)
result=0

for name in "${names[@]}"; do
    if ! slopmux_validate_name "$name" || ! slopmux_read_record "$name"; then
        echo "slopmux-rm: no valid agent named '$name' for $SLOPMUX_REPOSITORY_NAME" >&2
        result=1
        continue
    fi
    checkout=$SLOPMUX_CHECKOUT
    branch=$SLOPMUX_BRANCH
    record=$SLOPMUX_AGENTS/$name
    case $current_directory/ in
        "$checkout/"*)
            echo "slopmux-rm: cannot remove the checkout containing the current directory: $name" >&2
            result=1
            continue
            ;;
    esac
    if ! slopmux_checkout_has_branch "$checkout" "$branch"; then
        echo "slopmux-rm: agent '$name' is missing its checkout or assigned branch" >&2
        result=1
        continue
    fi
    if ! head_branch=$(git -C "$checkout" symbolic-ref --quiet --short HEAD); then
        echo "slopmux-rm: agent '$name' has a detached HEAD" >&2
        result=1
        continue
    fi
    if [[ $head_branch != "$branch" ]]; then
        echo "slopmux-rm: agent '$name' has HEAD on '$head_branch', not '$branch'" >&2
        result=1
        continue
    fi
    if [[ -n $(git -C "$checkout" status --porcelain --untracked-files=all) ]]; then
        echo "slopmux-rm: agent '$name' has tracked, staged, or untracked changes" >&2
        result=1
        continue
    fi
    expected_ref=refs/heads/$branch
    extra_refs=$(git -C "$checkout" for-each-ref --format='%(refname)' | \
        while IFS= read -r ref; do [[ $ref == "$expected_ref" ]] || echo "$ref"; done)
    if [[ -n $extra_refs ]]; then
        echo "slopmux-rm: agent '$name' has additional refs:" >&2
        printf '%s\n' "$extra_refs" >&2
        result=1
        continue
    fi

    if ! slopmux_sync_one "$name"; then
        result=1
        continue
    fi
    synchronized_oid=$(git -C "$checkout" rev-parse "$expected_ref")
    if [[ $delete_branch == true ]]; then
        if ! git -C "$SLOPMUX_PARENT" update-ref -d "$expected_ref" \
            "$synchronized_oid"; then
            echo "slopmux-rm: parent branch changed while removing agent '$name'" >&2
            result=1
            continue
        fi
    fi

    if ! rm -rf -- "$checkout"; then
        echo "slopmux-rm: could not remove checkout for agent '$name'" >&2
        result=1
        continue
    fi
    rm -rf -- "$record"
    echo "Removed agent: $name"
done
exit "$result"
