#!/usr/bin/env bash
set -euo pipefail

SLOPMUX_COMMAND=slopmux-ls
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/slopmux-common"

usage() {
    local status=${1:-2} fd=2
    (( status == 0 )) && fd=1
    echo "usage: slopmux-ls" >&"$fd"
    exit "$status"
}
if (( $# == 1 )) && [[ $1 == -h || $1 == --help ]]; then usage 0; fi
(( $# == 0 )) || usage

slopmux_locate_parent
slopmux_check_registry_version
mapfile -t names < <(slopmux_registered_names | LC_ALL=C sort)
if (( ${#names[@]} == 0 )); then
    echo "No agents found for $SLOPMUX_REPOSITORY_NAME."
    exit 0
fi

printf '%-24s  %-8s  %-12s  %-32s  %s\n' \
    AGENT TOOL STATUS BRANCH CHECKOUT
for name in "${names[@]}"; do
    status=missing
    checkout=-
    branch=-
    tool=-
    if slopmux_read_record "$name"; then
        checkout=$SLOPMUX_CHECKOUT
        branch=$SLOPMUX_BRANCH
        tool=${SLOPMUX_TOOL:--}
        if slopmux_checkout_has_branch "$checkout" "$branch"; then
            checkout_oid=$(git -C "$checkout" rev-parse "refs/heads/$branch")
            if parent_oid=$(git -C "$SLOPMUX_PARENT" rev-parse --verify \
                "refs/heads/$branch" 2>/dev/null); then
                if [[ $checkout_oid == "$parent_oid" ]]; then
                    status=ok
                else
                    status=different
                fi
            else
                status=unpublished
            fi
        fi
    fi
    printf '%-24s  %-8s  %-12s  %-32s  %s\n' \
        "$name" "$tool" "$status" "$branch" "$checkout"
done
