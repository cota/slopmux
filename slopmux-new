#!/usr/bin/env bash
set -euo pipefail

usage() {
    local status="${1:-2}"
    local output_fd=2
    (( status == 0 )) && output_fd=1
    echo "usage: slopmux-new [-t|--tool TOOL] NAME [base_branch]" >&"$output_fd"
    exit "$status"
}

agent_tool=""
tool_set=false
positionals=()
while (( $# > 0 )); do
    case "$1" in
        -h | --help) usage 0 ;;
        -t | --tool)
            (( $# >= 2 )) || usage
            [[ "$tool_set" == false ]] || usage
            agent_tool="$2"
            tool_set=true
            shift 2
            ;;
        --tool=*)
            [[ "$tool_set" == false ]] || usage
            agent_tool="${1#--tool=}"
            tool_set=true
            shift
            ;;
        -*) usage ;;
        *)
            positionals+=("$1")
            shift
            ;;
    esac
done

(( ${#positionals[@]} >= 1 && ${#positionals[@]} <= 2 )) || usage
name="${positionals[0]}"
base_branch="${positionals[1]:-}"

[[ "$tool_set" == false || -n "$agent_tool" ]] || usage

git_common_dir="$(git rev-parse --path-format=absolute --git-common-dir)"
repo="$(dirname "$git_common_dir")"
reponame=$(basename "$repo")
configured_base_branch=$(git -C "$repo" config --get slopmux.baseBranch \
    2>/dev/null || true)
configured_branch_prefix=$(git -C "$repo" config --get slopmux.branchPrefix \
    2>/dev/null || true)
worktree_root=$(git -C "$repo" config --type=path \
    --get slopmux.worktreeRoot 2>/dev/null || true)
sandbox_command=""
if configured_sandbox_command=$(git -C "$repo" config --type=path \
    --get slopmux.sandboxCommand 2>/dev/null)
then
    if [[ -z "$configured_sandbox_command" ]]; then
        echo "slopmux-new: slopmux.sandboxCommand is empty" >&2
        exit 1
    fi
    if [[ "$configured_sandbox_command" != /* ]]; then
        echo "slopmux-new: slopmux.sandboxCommand must be an absolute path" >&2
        exit 1
    fi
    if [[ ! -f "$configured_sandbox_command" ]]; then
        echo "slopmux-new: sandbox command does not exist: $configured_sandbox_command" \
            >&2
        exit 1
    fi
    if [[ ! -x "$configured_sandbox_command" ]]; then
        echo "slopmux-new: sandbox command is not executable: $configured_sandbox_command" \
            >&2
        exit 1
    fi
    sandbox_command="$configured_sandbox_command"
else
    status=$?
    # git config exits with 1 when the setting does not exist. In that case,
    # launch the agent directly; other failures are actual configuration errors.
    if (( status != 1 )); then
        echo "slopmux-new: could not read slopmux.sandboxCommand" >&2
        exit 1
    fi
fi

base_branch="${base_branch:-${configured_base_branch:-master}}"
branch_prefix="$configured_branch_prefix"
worktree_root="${worktree_root:-$HOME/.slopmux/worktrees}"
worktree_dir="$worktree_root/$reponame"
window_label="slop"
if [[ -n "$agent_tool" ]]; then
    window_label="$agent_tool"
fi
worktree="$worktree_dir/$name"
branch="$branch_prefix$name"

mkdir -p "$worktree_dir"
git -C "$repo" worktree add -b "$branch" "$worktree" "$base_branch"

git -C "$repo" config extensions.worktreeConfig true
git -C "$worktree" config --worktree slopmux.name "$name"
if [[ -n "$agent_tool" ]]; then
    git -C "$worktree" config --worktree slopmux.tool "$agent_tool"
fi

startup_file=$(mktemp "${TMPDIR:-/tmp}/slopmux-new.XXXXXX")
cleanup() {
    rm -f -- "$startup_file"
}
trap cleanup EXIT

{
    printf 'source %q\n' "$HOME/.bashrc"
    printf 'rm -f -- %q\n' "$startup_file"
    if [[ -n "$sandbox_command" ]]; then
        printf 'exec %q' "$sandbox_command"
        if [[ -n "$agent_tool" ]]; then
            printf ' %q' "$agent_tool"
        fi
        printf '\n'
    elif [[ -n "$agent_tool" ]]; then
        printf 'exec %q\n' "$agent_tool"
    fi
} >"$startup_file"

printf -v shell_command 'exec bash --rcfile %q -i' "$startup_file"
if ! tmux new-window \
    -n "[$window_label]$name" \
    -c "$worktree" \
    "$shell_command"
then
    exit 1
fi

# The new bash removes its startup file after opening it.
trap - EXIT
